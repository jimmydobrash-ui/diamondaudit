{
  "redirects": [
    { "source": "/auth", "destination": "https://app.diamondaudit.io/auth", "permanent": false },
    { "source": "/auth/:path*", "destination": "https://app.diamondaudit.io/auth/:path*", "permanent": false },
    { "source": "/players", "destination": "https://app.diamondaudit.io/players", "permanent": false },
    { "source": "/players/:path*", "destination": "https://app.diamondaudit.io/players/:path*", "permanent": false },
    { "source": "/evaluate", "destination": "https://app.diamondaudit.io/evaluate", "permanent": false },
    { "source": "/evaluate/:path*", "destination": "https://app.diamondaudit.io/evaluate/:path*", "permanent": false },
    { "source": "/team-builder", "destination": "https://app.diamondaudit.io/team-builder", "permanent": false },
    { "source": "/leaderboard", "destination": "https://app.diamondaudit.io/leaderboard", "permanent": false },
    { "source": "/settings/:path*", "destination": "https://app.diamondaudit.io/settings/:path*", "permanent": false },
    { "source": "/scoring-guide", "destination": "https://app.diamondaudit.io/scoring-guide", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.google-analytics.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    }
  ]
}
