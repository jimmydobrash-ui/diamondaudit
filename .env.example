VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# GA4 measurement ID for the app (app.diamondaudit.io). Public by design — it
# ships in the client bundle. Vite inlines VITE_* at BUILD time, so this must be
# set in Vercel *before* a build or production ships with analytics silently off;
# changing it afterwards requires a redeploy. Analytics is host-gated, so a value
# set locally still won't report from localhost.
# The marketing site has no build step and hardcodes the same ID in
# landing/analytics.js.
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
